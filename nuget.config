<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org for every dependency; the engine (RetroEng.*) from its public feed on GitHub Pages. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="retroeng" value="https://nautilusbits.github.io/retroeng-packages/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="retroeng">
      <package pattern="RetroEng.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
